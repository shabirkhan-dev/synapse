{
	"extends": "@synapse/typescript-config/base.json",
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"allowJs": false,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"incremental": false
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "bench/**/*.ts"],
	"exclude": ["node_modules"]
}
