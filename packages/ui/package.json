{
	"name": "@synapse/ui",
	"version": "0.0.0",
	"private": true,
	"sideEffects": ["**/*.css"],
	"type": "module",
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./components/*": "./src/components/*.tsx",
		"./lib/*": "./src/lib/*.ts",
		"./hooks/*": "./src/hooks/*.ts",
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@hugeicons/core-free-icons": "^4.4.0",
		"@hugeicons/react": "^1.1.10",
		"@shadcn/react": "^0.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"motion": "^14.9.0",
		"recharts": "3.10.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@synapse/typescript-config": "workspace:*",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19"
	},
	"peerDependenciesMeta": {
		"react-dom": {
			"optional": true
		}
	}
}
