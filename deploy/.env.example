# Production settings for deploy/compose.yml. Copy to deploy/.env (gitignored) and fill in; keep the
# real values in Doppler `synapse/prd` (docs/development/secrets.md). Never commit deploy/.env.

# Hosts on one registrable domain (ADR-0007), both pointed at this machine (DNS A/AAAA records).
CONSOLE_HOST=console.example.com
API_HOST=api.example.com
ACME_EMAIL=ops@example.com

POSTGRES_USER=synapse
POSTGRES_DB=synapse
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# openssl rand -base64 48
JWT_SECRET=change-me-to-32-or-more-random-characters
RESEND_API_KEY=re_change_me
EMAIL_FROM=Synapse <synapse@rabtx.dev>

# Models (docs/packages/providers.md). The default is an OpenAI-compatible endpoint (OpenRouter).
AI_API_KEY=change-me
AI_CHAT_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: USD per million tokens, for cost in traces and the console's Usage page.
AI_MODEL_PRICES=
# Optional: traces to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Backups: one pg_dump a day, kept 14 days, in deploy/backups (copy them off the machine).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

# Images: tag and registry prefix (CD pushes and pulls these).
IMAGE_PREFIX=synapse
IMAGE_TAG=latest
