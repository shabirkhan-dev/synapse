# Synapse — the one env file. Copy to .env (gitignored) at the repo root and fill in your keys:
#   cp .env.example .env
# Read by `docker compose` and by host runs (`bun run dev:api`, `db:migrate`, `eval:retrieval`,
# api tests). Never commit real keys. Empty values count as unset.

# ── Postgres (pgvector) ─────────────────────────────────────────────
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_DB=synapse
POSTGRES_PORT=5433
# Host runs; inside docker compose the API is pointed at the postgres service instead.
DATABASE_URL=postgresql://synapse:synapse@localhost:5433/synapse
DATABASE_POOL_MAX=5
# DATABASE_SSL=true
# Opt-in integration tests against a throwaway database with pgvector:
# API_TEST_DATABASE_URL=postgresql://synapse:synapse@localhost:5433/api_test

# ── API (apps/api) ──────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
API_PORT=8000
LOG_LEVEL=INFO
# LOG_FORMAT=json            # json | pretty (default: json in production, pretty otherwise)
# Verifies HS256 access tokens; 32+ chars, and production rejects the built-in development value.
JWT_SECRET=development-only-jwt-secret-change-me-now
# Access tokens live 15 minutes; a session (refresh token) lives 30 days from sign-in.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_TTL_DAYS=30
# Console URL that verification and password-reset links open.
APP_URL=http://localhost:3000
# true only behind one proxy you control: the client IP for rate limits comes from x-forwarded-for.
TRUST_PROXY=false
# Seconds the refresh token just replaced still gets an access token (two tabs at once); 0 = strict.
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
# `Secure` on the console's refresh-token cookie (ADR-0007). Unset = true in production only.
AUTH_COOKIE_SECURE=

# ── Email (Resend) ──────────────────────────────────────────────────
# Required in production. Without it (development) emails are written to the API log instead.
RESEND_API_KEY=
# Sender on the verified rabtx.dev domain in Resend (the key must be allowed to send from it).
EMAIL_FROM="Synapse <synapse@rabtx.dev>"
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
RUN_MIGRATIONS=true

# ── Models ──────────────────────────────────────────────────────────
# Vendor per use: openai-compatible (AI_BASE_URL below, default OpenRouter) | openai | anthropic |
# google | cohere. Embeddings: openai-compatible | openai | google | cohere (requested at 1536 dims).
# Changing the embedding vendor or model re-embeds old chunks (worker job on its next start).
AI_CHAT_PROVIDER=openai-compatible
AI_EMBEDDING_PROVIDER=openai-compatible
# Direct vendor keys, used only when that vendor is selected (or is the fallback).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
COHERE_API_KEY=
# The OpenAI-compatible endpoint
AI_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_NAME=openrouter
AI_API_KEY=
AI_CHAT_MODEL=openai/gpt-4o-mini
# Must return 1536 dimensions (the pgvector column size).
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional separate embeddings endpoint, e.g. https://api.openai.com/v1
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
# JSON prices for cost estimates, keyed by provider:model, e.g.
# AI_MODEL_PRICES={"openrouter:openai/gpt-4o-mini":{"inputPerMillionTokens":0.15,"outputPerMillionTokens":0.6}}
AI_MODEL_PRICES=
# Reliability (@synapse/reliability): per-attempt deadlines, total attempts for retryable errors
# (timeouts, 429, 5xx), and the circuit breaker (consecutive failures, then open this long).
AI_CHAT_TIMEOUT_MS=60000
AI_EMBEDDING_TIMEOUT_MS=30000
AI_RETRY_ATTEMPTS=3
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RESET_MS=30000
# Optional chat model used when the primary is down (api only); vendor defaults to AI_CHAT_PROVIDER.
AI_FALLBACK_CHAT_MODEL=
AI_FALLBACK_CHAT_PROVIDER=

# ── RAG ─────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# hybrid = vector + keyword (Postgres full-text) fused with RRF; vector = cosine only
RAG_SEARCH_MODE=hybrid
# Token budget for passages sent to the chat model (~4 characters per token)
RAG_MAX_CONTEXT_TOKENS=3000
# Optional second-stage reranking (cohere; needs COHERE_API_KEY). Unset = off. The best
# RAG_RERANK_CANDIDATES matches are reordered; one attempt within AI_RERANK_TIMEOUT_MS, and a
# failure falls back to the fused order.
AI_RERANK_PROVIDER=
AI_RERANK_MODEL=rerank-v3.5
AI_RERANK_TIMEOUT_MS=5000
RAG_RERANK_CANDIDATES=20
CHAT_MAX_STEPS=5
# Stored conversation history sent back to the model (~4 characters per token).
CHAT_HISTORY_MAX_TOKENS=6000
CHAT_HISTORY_MAX_MESSAGES=50

# ── Per-user budgets on model-calling routes (429 + Retry-After over budget) ──
# Questions = chat messages and /rag/query; ingests = pasted and uploaded documents.
RATE_LIMIT_QUESTIONS_PER_MINUTE=20
RATE_LIMIT_INGESTS_PER_HOUR=200
RATE_LIMIT_EVALUATION_RUNS_PER_HOUR=10

# ── Guardrails ──────────────────────────────────────────────────────
# Longest user input accepted; comma-separated blocked terms (empty = none).
GUARDRAILS_MAX_INPUT_CHARS=4000
GUARDRAILS_BLOCKED_TERMS=

# ── Tracing: Langfuse, or any OTLP/HTTP collector (one, not both) ───
# Langfuse project keys (Settings → API keys). Set both to send traces to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Worker (apps/worker): background jobs on pg-boss ───────────────
# Chunks per embedding call (and per checkpoint) when re-embedding after a model change.
WORKER_REEMBED_BATCH_SIZE=100

# ── Console (apps/console) ──────────────────────────────────────────
CONSOLE_PORT=3000
# API base URL the browser calls (inlined at build time; compose passes it as a build arg). Host
# runs (`bun run dev`) use the default; add the console origin to CORS_ORIGIN if you change ports.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Production (deploy/compose.yml) ────────────────────────────────
# The production stack reads its own file, deploy/.env (template deploy/.env.example): CONSOLE_HOST,
# API_HOST, ACME_EMAIL, BACKUP_INTERVAL_SECONDS, BACKUP_KEEP_DAYS, BACKUP_DIR, IMAGE_PREFIX,
# IMAGE_TAG, HTTP_PORT/HTTPS_PORT, plus BUILD_NETWORK/BUILD_CA_FILE for builds behind a
# TLS-inspecting proxy. Keep the real values in Doppler `synapse/prd`. See deploy/README.md.
