{
  "name": "starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --continue --filter=!rust --concurrency=12",
    "dev:rust": "bun --cwd=apps/rust run dev",
    "dev:ai": "bun --cwd=apps/ai-api run dev",
    "dev:all": "turbo run dev --continue --concurrency=12",
    "build": "turbo run build",
    "start": "turbo run start",
    "preflight": "bun run lint && bun run typecheck && bun run test",
    "lint": "turbo run lint && bun run scripts:lint",
    "lint:fix": "turbo run lint:fix",
    "format": "oxfmt && bun run scripts:format && (cd apps/rust && cargo fmt || true)",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && bun run test:scripts",
    "test:coverage": "(cd apps/web && bun run test:coverage) && (cd apps/nest-api && bun run test:cov) && (cd packages/logger && bun run test:coverage) && (cd apps/ai-api && bun run test:coverage) && (cd apps/mobile && bun run test) && (cd apps/rust && bun run test) && bun run test:scripts",
    "test:scripts": "bash scripts/bash/tests/main.test.sh",
    "test:e2e:web": "cd apps/web && bun run test:e2e",
    "architecture:check": "bash scripts/architecture/check-boundaries.sh",
    "naming:check": "bash scripts/architecture/check-naming.sh",
    "registry": "bun --cwd=packages/rabtx run registry",
    "registry:check": "bun --cwd=packages/rabtx run registry:check",
    "ci:lint": "bun run lint && bun run architecture:check && bun run registry:check",
    "ci:typecheck": "bun run typecheck",
    "ci:build": "bun run build",
    "ci:test": "bun run test:coverage",
    "ci:e2e:web": "bun run test:e2e:web",
    "scripts:lint": "shellcheck scripts/bash/*.sh scripts/bash/tests/*.sh scripts/git-hooks/*.sh scripts/architecture/*.sh",
    "scripts:format": "shfmt -i 4 -w scripts/bash/*.sh scripts/bash/tests/*.sh scripts/git-hooks/*.sh scripts/architecture/*.sh || true",
    "scripts:run": "bash scripts/bash/main.sh",
    "scripts:run:bash": "bash scripts/bash/main.sh",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "lightningcss": "1.33.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "lightningcss": "1.33.0",
    "@expo/dom-webview": "58.0.2",
    "@expo/log-box": "58.0.14",
    "@expo/metro-runtime": "58.0.16",
    "expo": "58.0.22",
    "expo-constants": "58.0.14",
    "expo-font": "58.0.11",
    "expo-glass-effect": "58.0.5",
    "expo-linking": "58.0.15",
    "expo-symbols": "58.0.4"
  }
}
