# Docker Compose env. Copy to .env and adjust.
# Used by: docker compose (postgres, api, console). Fragments: docker/compose/*.yml

# Postgres
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_DB=synapse
POSTGRES_PORT=5433

# API (apps/api). JWT_SECRET verifies HS256 access tokens (32+ chars in production).
API_PORT=8000
JWT_SECRET=development-only-jwt-secret-change-me-now
CORS_ORIGIN=http://localhost:3000
RUN_MIGRATIONS=true
# Any OpenAI-compatible endpoint; defaults to OpenRouter. Put your real key only in .env (never commit it).
AI_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_NAME=openrouter
AI_API_KEY=replace-with-your-openrouter-key
AI_CHAT_MODEL=openai/gpt-4o-mini
# Must return 1536 dimensions (the pgvector column size).
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional separate embeddings endpoint, e.g. https://api.openai.com/v1
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=

# Next.js console
CONSOLE_PORT=3000
