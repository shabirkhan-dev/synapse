{
	"extends": "@synapse/typescript-config/base.json",
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"types": ["node"],
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", ".output"]
}
