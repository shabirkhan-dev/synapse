# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and all packages/apps)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# Claude Code: keep personal settings local, share the skills link
.claude/*
!.claude/skills
.codex/
# testing
/coverage

# next.js (any .next dir in repo)
.next/
.out/

# production / build output
/build
dist/

# misc
.DS_Store
Thumbs.db
*.pem
*~
*.swp
*.swo
*.log
.cache/
*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# turborepo (cache – do not track)
.turbo/

# playwright
playwright-report/
test-results/

# coverage
coverage/
**/coverage/

# rust (Cargo)
target/

# curl cookie jars (may contain live auth tokens)
cookie.txt
*.cookie.txt

# c (build output)
apps/c/build/
*.o
*.a
*.so
*.d
.deps/

# just (optional: local overrides / cache if any)
.just-*

# scripts – build/cache
# lua (if any)
*.luac

# oxc (cache)
.oxlintcache

# editor / IDE (local only)
.idea/

# root workspace generated / temp (remove from .gitignore to track)
root.ts
packages/native/bin/
