{
	"name": "worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --env-file=../../.env --watch src/worker.ts",
		"build": "bun build src/worker.ts --target=bun --outdir=dist --root=src",
		"start": "bun dist/worker.js",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit",
		"test": "bun --env-file=../../.env test",
		"test:coverage": "bun --env-file=../../.env test --coverage"
	},
	"dependencies": {
		"@synapse/adapters": "workspace:*",
		"@synapse/core": "workspace:*",
		"@synapse/database": "workspace:*",
		"@synapse/knowledge": "workspace:*",
		"@synapse/observability": "workspace:*",
		"drizzle-orm":"^0.45.4",
		"zod":"^4.6.7"
	},
	"devDependencies": {
		"@synapse/typescript-config": "workspace:*",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
