{
	"name": "api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT OR Apache-2.0",
	"scripts": {
		"dev": "bun --watch src/server.ts",
		"build": "bun build src/server.ts src/migrate.ts --target=bun --outdir=dist --root=src && rm -rf dist/migrations && cp -r ../../packages/database/migrations dist/migrations",
		"start": "bun dist/server.js",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:coverage": "bun test --coverage"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@scalar/hono-api-reference": "^0.12.18",
		"@synapse/adapters": "workspace:*",
		"@synapse/core": "workspace:*",
		"@synapse/database": "workspace:*",
		"@synapse/ingestion": "workspace:*",
		"@synapse/knowledge": "workspace:*",
		"ai": "^7.0.164",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.17",
		"jose": "^6.2.15",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@ai-sdk/provider": "^4.0.36",
		"@synapse/typescript-config": "workspace:*",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
