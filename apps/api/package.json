{
	"name": "api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT OR Apache-2.0",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"build": "bun build src/index.ts src/database/migrate.ts --target=bun --outdir=dist --root=src && rm -rf dist/database/migrations && cp -r src/database/migrations dist/database/migrations",
		"start": "bun dist/index.js",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun src/database/migrate.ts"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.86",
		"@hono/zod-openapi": "^1.6.3",
		"@scalar/hono-api-reference": "^0.12.18",
		"@synapse/logger": "workspace:*",
		"ai": "^7.0.164",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.17",
		"jose": "^6.2.15",
		"postgres": "^4.1.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@ai-sdk/provider": "^4.0.36",
		"@synapse/typescript-config": "workspace:*",
		"@types/bun": "^1.4.4",
		"drizzle-kit": "^0.31.11",
		"typescript": "^7.0.2"
	}
}
