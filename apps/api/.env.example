# apps/api — copy to .env (gitignored) and adjust. Never commit real keys.
NODE_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Postgres with the pgvector extension (docker compose: pgvector/pgvector:pg18 on host :5433).
DATABASE_URL=postgresql://synapse:synapse@localhost:5433/synapse
DATABASE_POOL_MAX=5
# DATABASE_SSL=true

# HS256 secret used to verify access tokens (32+ chars in production).
JWT_SECRET=development-only-jwt-secret-change-me
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Any OpenAI-compatible endpoint. Defaults to OpenRouter.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_NAME=openrouter
# AI_API_KEY=
AI_CHAT_MODEL=openai/gpt-4o-mini
# Must return 1536 dimensions (the vector column size).
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional separate embeddings endpoint, e.g. https://api.openai.com/v1
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# hybrid = vector + keyword (Postgres full-text) fused with RRF; vector = cosine only
RAG_SEARCH_MODE=hybrid
# Token budget for passages sent to the chat model (~4 characters per token)
RAG_MAX_CONTEXT_TOKENS=3000

# Observability
# LOG_FORMAT=json            # json | pretty (default: json in production, pretty otherwise)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # export traces over OTLP/HTTP
# AI_MODEL_PRICES={"openrouter:openai/gpt-4o-mini":{"inputPerMillionTokens":0.15,"outputPerMillionTokens":0.6}}
CHAT_MAX_STEPS=5

# Opt-in integration test against real pgvector (a throwaway database):
# API_TEST_DATABASE_URL=postgresql://synapse:synapse@localhost:5433/api_test
